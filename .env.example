# ==============================================================
# ULEARN EDUCATIONAL MARKETPLACE ENVIRONMENT CONFIGURATION
# ==============================================================

# Database
# Default: Local SQLite for seamless instant zero-config setup
# Production: Switch to PostgreSQL (e.g. postgresql://user:pass@localhost:5432/ulearn)
DATABASE_URL="file:./dev.db"

# Next.js App
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ulearn_super_secret_jwt_key_development_only_change_in_production"

# Payment Gateways (Sandbox Mode)
STRIPE_PUBLIC_KEY="pk_test_sample_sandbox_key"
STRIPE_SECRET_KEY="sk_test_sample_sandbox_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_sandbox_webhook"
PAYPAL_CLIENT_ID="sandbox_paypal_client_id"

# Video Streaming & Cloud Object Storage
CLOUDFLARE_STREAM_API_KEY=""
AWS_S3_BUCKET_NAME="ulearn-course-assets"
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# AI Learning Assistant & Generative Models
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Platform Governance
DEFAULT_COMMISSION_PERCENT=15
MINIMUM_PAYOUT_THRESHOLD_CENTS=5000
